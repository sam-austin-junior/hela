# Copy to .env and fill in. .env is git-ignored.

# The chat agent needs ONE of these two keys.
# Claude (default when set): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Free alternative, open models on Groq (no card needed): https://console.groq.com
GROQ_API_KEY=

# Paystack TEST secret key (sk_test_...). Live keys are refused.
# Leave empty to use the built-in simulated sandbox instead.
PAYSTACK_SECRET_KEY=

# Where the browser reaches the app (used for Paystack's return URL).
PUBLIC_URL=http://localhost:8787

# Optional
# DATABASE_URL=postgres://hela:hela@127.0.0.1:5544/hela
# HELA_MODEL=claude-opus-5-5
# HELA_GROQ_MODEL=openai/gpt-oss-120b
# HELA_MODEL_PROVIDER=anthropic   # or groq, to force one when both keys are set
